{
  "agents": {
    "builder": {
      "description": "Makes one clearly specified change, runs its checks and reports. Never commits.",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-5-5#high",
      "steps": 60,
      "permissions": [
        {
          "action": "shell",
          "resource": "git add *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git commit *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git push *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git pull *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git fetch *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git reset *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git rebase *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git merge *",
          "effect": "deny"
        },
        {
          "action": "shell",
