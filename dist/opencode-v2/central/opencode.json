          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git branch *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git remote *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git worktree *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git update-ref *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git config *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git -C *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "gh *",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "skill",
          "resource": "ecmwf-multi-agents-*",
          "effect": "deny"
        },
        {
          "action": "helpers_status",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "helpers_steer",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "helpers_cancel",
          "resource": "*",
          "effect": "deny"
        }
      ],
      "hidden": false,
      "system": "{file:./prompts/builder.md}"
    },
    "lead": {
      "description": "Talks to you, plans, hands work to helpers and checks the results. Start here.",
      "mode": "primary",
      "model": "anthropic/claude-opus-5-5#xhigh",
      "color": "#0b5394",
      "permissions": [
        {
          "action": "question",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "scout",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "builder",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "reviewer",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git -C * push *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git commit --amend *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git reset --hard *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git clean *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git rebase *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git branch -D *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git restore *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git checkout -- *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git stash drop *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git stash clear *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "gh pr create *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "gh pr merge *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "gh pr close *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "gh release *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "gh repo delete *",
          "effect": "ask"
        }
      ],
      "hidden": false,
      "system": "{file:./prompts/lead.md}"
    },
