  "commands": {
    "execute": {
      "description": "Carry out an approved plan: ready tasks run together in the background, every result is checked; stops when it needs you",
      "agent": "lead",
      "template": "{file:./prompts/commands/execute.md}"
    },
    "guide": {
      "description": "How this harness works, in plain words",
      "agent": "lead",
      "template": "{file:./prompts/commands/guide.md}"
    },
    "onboard": {
      "description": "Survey this repository and keep a short summary for later sessions",
      "agent": "lead",
      "template": "{file:./prompts/commands/onboard.md}"
    },
    "plan": {
      "description": "Plan a piece of work with you, then wait for your approval",
      "agent": "lead",
      "template": "{file:./prompts/commands/plan.md}"
    },
    "progress": {
      "description": "Show progress on the current plan",
      "agent": "scout",
      "subagent": true,
      "template": "{file:./prompts/commands/progress.md}"
    },
    "review": {
      "description": "Independent review of your uncommitted changes, a branch, a commit, a pull request or a plan",
      "agent": "reviewer",
      "subagent": true,
      "template": "{file:./prompts/commands/review.md}"
    }
  },
  "skills": [
    "@ECMWF_MULTI_AGENTS_DIR@/skills"
  ],
  "plugins": [
    {
      "package": "@ECMWF_MULTI_AGENTS_DIR@/plugins/ecmwf-multi-agents",
      "options": {
        "site": "@ECMWF_MULTI_AGENTS_DIR@/ecmwf-multi-agents.jsonc"
      }
    }
  ]
}
