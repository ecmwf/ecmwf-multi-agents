{
  "id": "default",
  "description": "Anthropic for lead, scout and builder; GitHub Copilot GPT for the reviewer and the tester, so they check work with a different model family, or Claude Opus where GitHub Copilot is not set up.",
  "agents": {
    "lead": {
      "model": "anthropic/claude-opus-5-5",
      "effort": "xhigh"
    },
    "scout": {
      "model": "anthropic/claude-sonnet-5-5",
      "effort": "medium"
    },
    "builder": {
      "model": "anthropic/claude-sonnet-5-5",
      "effort": "high"
    },
    "reviewer": {
      "model": "github-copilot/gpt-6.1-sol",
      "effort": "medium",
      "fallback": [
        {
          "model": "anthropic/claude-opus-5-5",
          "effort": "high"
        }
      ]
    },
    "researcher": {
      "model": "anthropic/claude-opus-5-5",
      "effort": "xhigh"
    },
    "tester": {
      "model": "github-copilot/gpt-6.1-sol",
      "effort": "high",
      "fallback": [
        {
          "model": "anthropic/claude-opus-5-5",
          "effort": "high"
        }
      ]
    },
    "designer": {
      "model": "anthropic/claude-opus-5-5",
      "effort": "high"
    },
    "data-scientist": {
      "model": "anthropic/claude-sonnet-5-5",
      "effort": "high"
    }
  }
}
