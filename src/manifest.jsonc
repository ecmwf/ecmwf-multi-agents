//
// Single source for the harness. The generator (tools/) reads this file, the Markdown it
// names and the VERSION file at the repository root, and writes dist/opencode-v2/. Paths are
// relative to src/.
// Permission actions are neutral; the emitter maps them to opencode's: delegate to subagent,
// execute to Code Mode, the others by name. Rules are ordered and the last match wins. Agent rules come after the user's own
// rules, so allow and ask rules here override the user's policy: keep them few and deliberate.
{
  "name": "ecmwf-multi-agents",
  "defaultAgent": "lead",
  "defaultProfile": "default",
  "workDir": ".ecmwf-multi-agents",
  "marker": "# managed by ecmwf-multi-agents",

  // Approximate tokens, counted as characters / 4. A budget is a ceiling, raised only to the
  // measured size of a change, rounded up to the next 50, with the reason here:
  // - lead 1800 -> 2050, helper 700 -> 750, skill 1200 -> 1450: the background helper rules
  //   (hand off in the background or not, read a completion as a report, steer or cancel) and
  //   the users' guide to them. Measured 2010, 712 and 1439 (docs/adr/0002).
  // - skill 1450 -> 1500: `/execute` asks before resuming a plan still in progress from another
  //   session, whose helpers may still be running there, and answers the user before it acts
  //   on a completion, even one that arrives during the lookup. Measured 1492.
  // - routing 100, lead-all: an optional helper's line in lead's helper list, and lead's prompt
  //   with every such line and the line for helpers that are off (ADR 0005); lead-all is the
  //   measured size of that largest prompt, rounded up to the next 50. Measured 2396, with
  //   the tester's note that its failing tests are kept, lead's rule never to review its own
  //   work while the reviewer is off, and the data scientist's folder named in its line.
  // - skill 1500 -> 1750: the users' guide to the optional helpers and to switching helpers on
  //   and off. Measured 1736; the guide is loaded only when the user asks how the harness works.
  // - lead 2050 -> 1900, lead-all 2400 -> 2250, lowered to the measured size: lead's prompt no
  //   longer repeats what the descriptions of its tools say (the helper tools, the delegation
  //   tool's background option and helper list, the question tool's recommended option).
  //   Measured 1893 and 2241.
  // - lead 1900 -> 1800, lead-all 2250 -> 2150, lowered to the measured size: lead's prompt
  //   carries only the review policy in force (reviewPolicies), and the plugin, not lead, adds
  //   the work folder to git's exclude file. Measured 1795 and 2142.
  // - skill 1750 -> 1850: the users' guide to fallback models, keeping what it says about a
  //   project switching helpers, the helper limit and the folders kept out of git. Measured 1835.
  "budgets": { "lead": 1800, "helper": 750, "command": 500, "skill": 1850, "routing": 100, "lead-all": 2150 },

  // Named lists of {action, resource}. A permission entry {"use": name, "effect": e}
  // expands to one rule per item, all with effect e.
  "ruleSets": {
    // Commands that publish work or destroy uncommitted or committed work.
    "approval-needed": [
      { "action": "shell", "resource": "git push *" },
      { "action": "shell", "resource": "git -C * push *" },
      { "action": "shell", "resource": "git commit --amend *" },
      { "action": "shell", "resource": "git reset --hard *" },
      { "action": "shell", "resource": "git clean *" },
      { "action": "shell", "resource": "git rebase *" },
      { "action": "shell", "resource": "git branch -D *" },
      { "action": "shell", "resource": "git restore *" },
      { "action": "shell", "resource": "git checkout -- *" },
      { "action": "shell", "resource": "git stash drop *" },
      { "action": "shell", "resource": "git stash clear *" },
      { "action": "shell", "resource": "gh pr create *" },
      { "action": "shell", "resource": "gh pr merge *" },
      { "action": "shell", "resource": "gh pr close *" },
      { "action": "shell", "resource": "gh release *" },
      { "action": "shell", "resource": "gh repo delete *" },
      // Filing an issue publishes the tester's draft; lead files one only when the user approves.
      { "action": "shell", "resource": "gh issue create *" }
    ],
    // Git commands that change history, the index, branches, remotes or the working tree
    // state that lead manages. Helpers never run these, not even their read-only forms such
    // as listing branches: they use `git rev-parse` and `git show` instead. `git -C` is
    // denied whole, because it would run any of these on another path.
    "git-writes": [
      { "action": "shell", "resource": "git add *" },
      { "action": "shell", "resource": "git commit *" },
      { "action": "shell", "resource": "git push *" },
      { "action": "shell", "resource": "git pull *" },
      { "action": "shell", "resource": "git fetch *" },
      { "action": "shell", "resource": "git reset *" },
      { "action": "shell", "resource": "git rebase *" },
      { "action": "shell", "resource": "git merge *" },
      { "action": "shell", "resource": "git cherry-pick *" },
      { "action": "shell", "resource": "git revert *" },
      { "action": "shell", "resource": "git am *" },
      { "action": "shell", "resource": "git checkout *" },
      { "action": "shell", "resource": "git switch *" },
      { "action": "shell", "resource": "git restore *" },
      { "action": "shell", "resource": "git stash *" },
      { "action": "shell", "resource": "git clean *" },
      { "action": "shell", "resource": "git rm *" },
      { "action": "shell", "resource": "git mv *" },
      { "action": "shell", "resource": "git tag *" },
      { "action": "shell", "resource": "git branch *" },
      { "action": "shell", "resource": "git remote *" },
      { "action": "shell", "resource": "git worktree *" },
      { "action": "shell", "resource": "git update-ref *" },
      { "action": "shell", "resource": "git config *" },
      { "action": "shell", "resource": "git -C *" }
    ],
    // Inspection commands scouts may run. Everything else in the shell is denied for them.
    "read-only-shell": [
      { "action": "shell", "resource": "git log *" },
      { "action": "shell", "resource": "git show *" },
      { "action": "shell", "resource": "git diff *" },
      { "action": "shell", "resource": "git blame *" },
      { "action": "shell", "resource": "git status *" },
      { "action": "shell", "resource": "git grep *" },
      { "action": "shell", "resource": "git ls-files *" },
      { "action": "shell", "resource": "git rev-parse *" },
      { "action": "shell", "resource": "ls *" },
      { "action": "shell", "resource": "wc *" },
      { "action": "shell", "resource": "file *" },
      { "action": "shell", "resource": "tree *" }
    ],
    // Reading pull requests, for the reviewer.
    "gh-read": [
      { "action": "shell", "resource": "gh pr view *" },
      { "action": "shell", "resource": "gh pr diff *" },
      { "action": "shell", "resource": "gh pr checks *" }
    ],
    // The tools the plugin adds for lead: see, redirect and stop its helpers. Denied to every
    // helper, so a helper never steers or cancels a sibling; the plugin guard checks again.
    "helper-tools": [
      { "action": "tool", "resource": "helpers_status" },
      { "action": "tool", "resource": "helpers_steer" },
      { "action": "tool", "resource": "helpers_cancel" }
    ]
  },

  "agents": {
    "lead": {
      "mode": "primary",
      "description": "Talks to you, plans, hands work to helpers and checks the results. Start here.",
      "prompt": ["agents/lead.md"],
      "budget": "lead",
      "color": "#0b5394",
      "permissions": [
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "delegate", "resource": "*", "effect": "deny" },
        { "action": "delegate", "resource": "scout", "effect": "allow" },
        { "action": "delegate", "resource": "builder", "effect": "allow" },
        { "action": "delegate", "resource": "reviewer", "effect": "allow" },
        // No rule for the optional helpers: the plugin allows each one after these while it is
        // on, so an agent of the user's with one of their names stays out of reach.
        { "use": "approval-needed", "effect": "ask" }
      ]
    },

    "scout": {
      "mode": "subagent",
      "description": "Read-only lookups and investigations in code, docs or the web. Returns a short answer with file:line evidence; long findings go to a notes file.",
      "prompt": ["agents/scout.md"],
      "budget": "helper",
      "steps": 30,
      // Edits are denied except the notes folder. Paths match relative to the session
      // directory; the second pattern covers sessions started in a subdirectory.
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": ".ecmwf-multi-agents/notes/*", "effect": "allow" },
        { "action": "edit", "resource": "*/.ecmwf-multi-agents/notes/*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "use": "read-only-shell", "effect": "allow" },
        { "action": "delegate", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "execute", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "ecmwf-multi-agents-*", "effect": "deny" },
        { "use": "helper-tools", "effect": "deny" }
      ]
    },

    "builder": {
      "mode": "subagent",
      "description": "Makes one clearly specified change, runs its checks and reports. Never commits.",
      "prompt": ["agents/builder.md"],
      "budget": "helper",
      "steps": 60,
      "permissions": [
        { "use": "git-writes", "effect": "deny" },
        { "action": "shell", "resource": "gh *", "effect": "deny" },
        { "action": "delegate", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "ecmwf-multi-agents-*", "effect": "deny" },
        { "use": "helper-tools", "effect": "deny" }
      ]
    },

    "reviewer": {
      "mode": "subagent",
      "description": "Independent review of a plan or a change. Answers APPROVE or REJECT with at most three blockers.",
      "prompt": ["agents/reviewer.md"],
      "budget": "helper",
      "steps": 30,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "use": "git-writes", "effect": "deny" },
        { "action": "shell", "resource": "gh *", "effect": "deny" },
        { "use": "gh-read", "effect": "allow" },
        { "action": "delegate", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "execute", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "ecmwf-multi-agents-*", "effect": "deny" },
        { "use": "helper-tools", "effect": "deny" }
      ]
    },

    // Optional helpers (ADR 0005): off until a settings file switches them on, and then
    // registered by the plugin alone; they have no generated file. `routing` is the line the
    // plugin adds to lead's helper list while the helper is on. They run code, so their shell
    // is the user's policy with git and `gh` writes denied. Code Mode stays the user's policy,
    // as for builder, for the MCP servers each may need: documentation and search for
    // researcher, Playwright for tester and designer, data services for data-scientist; it
    // costs about 2,200 tokens a request where it is not denied. No browser rule: opencode's
    // browser tools only work in the session a desktop browser attached to, never in a helper's.
    "researcher": {
      "mode": "subagent",
      "description": "Deep investigation of a hard question: compares options, may run experiments in a scratch folder, and writes a report.",
      "prompt": ["agents/researcher.md"],
      "budget": "helper",
      "steps": 80,
      "optional": true,
      "routing": "a hard question that needs depth: comparing options, finding out why, or an experiment that settles it, run in its scratch folder. It costs more than a scout, so not for lookups. It changes no project file (check `git status`); its full findings are in its notes file.",
      // Edits are denied except its notes and scratch folders, as for scout.
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": ".ecmwf-multi-agents/notes/*", "effect": "allow" },
        { "action": "edit", "resource": "*/.ecmwf-multi-agents/notes/*", "effect": "allow" },
        { "action": "edit", "resource": ".ecmwf-multi-agents/scratch/*", "effect": "allow" },
        { "action": "edit", "resource": "*/.ecmwf-multi-agents/scratch/*", "effect": "allow" },
        { "use": "git-writes", "effect": "deny" },
        { "action": "shell", "resource": "gh *", "effect": "deny" },
        { "action": "delegate", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "ecmwf-multi-agents-*", "effect": "deny" },
        { "use": "helper-tools", "effect": "deny" }
      ]
    },

    "tester": {
      "mode": "subagent",
      "description": "Tries to break a change or a piece of code with edge cases and new tests; never fixes product code; drafts issues.",
      "prompt": ["agents/tester.md"],
      "budget": "helper",
      "steps": 60,
      "optional": true,
      "routing": "tries to break a change or a piece of code with edge cases and new tests, and fixes nothing. Check that it changed only test files; its failing tests show real bugs, so keep them. Show its issue drafts in `.ecmwf-multi-agents/issues/` to the user; file one with `gh issue create` only when the user approves.",
      // Test files can be anywhere in a project, so edits follow the user's policy, as for
      // builder; its prompt and lead's check keep it to test files.
      "permissions": [
        { "use": "git-writes", "effect": "deny" },
        { "action": "shell", "resource": "gh *", "effect": "deny" },
        { "action": "delegate", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "ecmwf-multi-agents-*", "effect": "deny" },
        { "use": "helper-tools", "effect": "deny" }
      ]
    },

    "designer": {
      "mode": "subagent",
      "description": "Designs user interfaces and interactions: a spec, a standalone prototype and screenshots. Never changes the project's code.",
      "prompt": ["agents/designer.md"],
      "budget": "helper",
      "steps": 60,
      "optional": true,
      "routing": "designs an interface or an interaction: a spec, a prototype and screenshots in `.ecmwf-multi-agents/design/`; it changes no project file (check `git status`). Take its QUESTIONS to the user, then brief a builder with the agreed spec.",
      // Edits are denied except its design folder.
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": ".ecmwf-multi-agents/design/*", "effect": "allow" },
        { "action": "edit", "resource": "*/.ecmwf-multi-agents/design/*", "effect": "allow" },
        { "use": "git-writes", "effect": "deny" },
        { "action": "shell", "resource": "gh *", "effect": "deny" },
        { "action": "delegate", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "ecmwf-multi-agents-*", "effect": "deny" },
        { "use": "helper-tools", "effect": "deny" }
      ]
    },

    "data-scientist": {
      "mode": "subagent",
      "description": "Answers questions about datasets with scripts it writes and runs, keeping the data out of its context.",
      "prompt": ["agents/data-scientist.md"],
      "budget": "helper",
      "steps": 60,
      "optional": true,
      "routing": "answers questions about datasets with scripts it runs, never reading the data itself. Its scripts and results belong in `.ecmwf-multi-agents/data/`, not a project file; it changes nothing else (check `git status`). Give it the data's paths; it downloads nothing, so fetch data only when the user agrees.",
      // Edits are denied except its data folder; the input data stays read-only.
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": ".ecmwf-multi-agents/data/*", "effect": "allow" },
        { "action": "edit", "resource": "*/.ecmwf-multi-agents/data/*", "effect": "allow" },
        { "use": "git-writes", "effect": "deny" },
        { "action": "shell", "resource": "gh *", "effect": "deny" },
        { "action": "delegate", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "ecmwf-multi-agents-*", "effect": "deny" },
        { "use": "helper-tools", "effect": "deny" }
      ]
    }
  },

  // What each review policy means. lead's prompt says the one in force on the line after
  // `Review policy: <policy>`: the generated prompt the default's, the plugin the setting's.
  "reviewPolicies": {
    "auto": "The reviewer checks each plan before the user approves it, and each change beyond a trivial edit.",
    "ask": "Ask the user before each review: of each plan before the user approves it, and of each change beyond a trivial edit.",
    "always": "The reviewer checks every plan and every change.",
    "never": "The reviewer checks work only when the user asks."
  },

  // Added to lead's helper list when a helper that is on by default is switched off.
  "helperOff": "Helpers not in this list are switched off in this project: do their work yourself, also where a command or skill names them, but never review your own work: without the reviewer, say no independent review is available.",

  // Names checked against opencode's built-in commands in docs/research/command-clashes.md.
  // `review` deliberately replaces opencode's built-in review command.
  //
  // `review` and `progress` belong to a helper. The plugin runs them in the user's own session
  // (plugin/inline.ts); without it, the command files run them in a child session and lead
  // relays the report (see tools/emit-v2.ts).
  "commands": {
    "onboard": {
      "description": "Survey this repository and keep a short summary for later sessions",
      "agent": "lead",
      "template": "commands/onboard.md"
    },
    "plan": {
      "description": "Plan a piece of work with you, then wait for your approval",
      "agent": "lead",
      "template": "commands/plan.md"
    },
    "execute": {
      "description": "Carry out an approved plan: ready tasks run together in the background, every result is checked; stops when it needs you",
      "agent": "lead",
      "template": "commands/execute.md"
    },
    "review": {
      "description": "Independent review of your uncommitted changes, a branch, a commit, a pull request or a plan",
      "agent": "reviewer",
      "template": "commands/review.md"
    },
    "progress": {
      "description": "Show progress on the current plan",
      "agent": "scout",
      "template": "commands/progress.md"
    },
    "guide": {
      "description": "How this harness works, in plain words",
      "agent": "lead",
      "template": "commands/guide.md"
    }
  },

  "skills": {
    "ecmwf-multi-agents-plan": {
      "description": "Plan file format and rules for ecmwf-multi-agents. Use when writing, updating or carrying out a plan in .ecmwf-multi-agents/plans/.",
      "body": "skills/ecmwf-multi-agents-plan/SKILL.md",
      "hidden": true
    },
    "ecmwf-multi-agents-guide": {
      "description": "User guide to the ecmwf-multi-agents harness: agents, commands, plans, review policy, settings and profiles. Use when the user asks how the harness works.",
      "body": "skills/ecmwf-multi-agents-guide/SKILL.md",
      "hidden": true
    }
  }
}
