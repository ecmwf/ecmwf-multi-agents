// SPDX-FileCopyrightText: 2026 European Centre for Medium-Range Weather Forecasts (ECMWF)
// SPDX-License-Identifier: Apache-2.0
//
// Single source for the harness. The generator (tools/) reads this file, the Markdown it
// names and the VERSION file at the repository root, and writes dist/opencode-v1/ and
// dist/opencode-v2/. Paths are relative to src/.
// Permission actions are platform neutral; the emitters map them: shell to bash (v1) or shell
// (v2), delegate to task or subagent, todo to todowrite (v1 only), execute to Code Mode (v2
// only). Rules are ordered and the last match wins. Agent rules come after the user's own
// rules, so allow and ask rules here override the user's policy: keep them few and deliberate.
{
  "name": "ecmwf-multi-agents",
  "defaultAgent": "lead",
  "defaultProfile": "default",
  "workDir": ".ecmwf-multi-agents",
  "marker": "# managed by ecmwf-multi-agents",

  // Approximate tokens, counted as characters / 4. A budget is a ceiling, raised only to the
  // measured size of a change, rounded up to the next 50, with the reason here:
  // - lead 1800 -> 2050, helper 700 -> 750, skill 1200 -> 1450: the background helper rules
  //   (hand off in the background or not, read a completion as a report, steer or cancel) and
  //   the users' guide to them. Measured 2010, 712 and 1439 (docs/adr/0002).
  "budgets": { "lead": 2050, "helper": 750, "command": 500, "skill": 1450 },

  // Named lists of {action, resource}. A permission entry {"use": name, "effect": e}
  // expands to one rule per item, all with effect e.
  "ruleSets": {
    // Commands that publish work or destroy uncommitted or committed work.
    "approval-needed": [
      { "action": "shell", "resource": "git push *" },
      { "action": "shell", "resource": "git -C * push *" },
      { "action": "shell", "resource": "git commit --amend *" },
      { "action": "shell", "resource": "git reset --hard *" },
      { "action": "shell", "resource": "git clean *" },
      { "action": "shell", "resource": "git rebase *" },
      { "action": "shell", "resource": "git branch -D *" },
      { "action": "shell", "resource": "git restore *" },
      { "action": "shell", "resource": "git checkout -- *" },
      { "action": "shell", "resource": "git stash drop *" },
      { "action": "shell", "resource": "git stash clear *" },
      { "action": "shell", "resource": "gh pr create *" },
      { "action": "shell", "resource": "gh pr merge *" },
      { "action": "shell", "resource": "gh pr close *" },
      { "action": "shell", "resource": "gh release *" },
      { "action": "shell", "resource": "gh repo delete *" }
    ],
    // Git commands that change history, the index, branches, remotes or the working tree
    // state that lead manages. Helpers never run these, not even their read-only forms such
    // as listing branches: they use `git rev-parse` and `git show` instead. `git -C` is
    // denied whole, because it would run any of these on another path.
    "git-writes": [
      { "action": "shell", "resource": "git add *" },
      { "action": "shell", "resource": "git commit *" },
      { "action": "shell", "resource": "git push *" },
      { "action": "shell", "resource": "git pull *" },
      { "action": "shell", "resource": "git fetch *" },
      { "action": "shell", "resource": "git reset *" },
      { "action": "shell", "resource": "git rebase *" },
      { "action": "shell", "resource": "git merge *" },
      { "action": "shell", "resource": "git cherry-pick *" },
      { "action": "shell", "resource": "git revert *" },
      { "action": "shell", "resource": "git am *" },
      { "action": "shell", "resource": "git checkout *" },
      { "action": "shell", "resource": "git switch *" },
      { "action": "shell", "resource": "git restore *" },
      { "action": "shell", "resource": "git stash *" },
      { "action": "shell", "resource": "git clean *" },
      { "action": "shell", "resource": "git rm *" },
      { "action": "shell", "resource": "git mv *" },
      { "action": "shell", "resource": "git tag *" },
      { "action": "shell", "resource": "git branch *" },
      { "action": "shell", "resource": "git remote *" },
      { "action": "shell", "resource": "git worktree *" },
      { "action": "shell", "resource": "git update-ref *" },
      { "action": "shell", "resource": "git config *" },
      { "action": "shell", "resource": "git -C *" }
    ],
    // Inspection commands scouts may run. Everything else in the shell is denied for them.
    "read-only-shell": [
      { "action": "shell", "resource": "git log *" },
      { "action": "shell", "resource": "git show *" },
      { "action": "shell", "resource": "git diff *" },
      { "action": "shell", "resource": "git blame *" },
      { "action": "shell", "resource": "git status *" },
      { "action": "shell", "resource": "git grep *" },
      { "action": "shell", "resource": "git ls-files *" },
      { "action": "shell", "resource": "git rev-parse *" },
      { "action": "shell", "resource": "ls *" },
      { "action": "shell", "resource": "wc *" },
      { "action": "shell", "resource": "file *" },
      { "action": "shell", "resource": "tree *" }
    ],
    // Reading pull requests, for the reviewer.
    "gh-read": [
      { "action": "shell", "resource": "gh pr view *" },
      { "action": "shell", "resource": "gh pr diff *" },
      { "action": "shell", "resource": "gh pr checks *" }
    ],
    // The tools the plugin adds for lead: see, redirect and stop its helpers. Denied to every
    // helper, so a helper never steers or cancels a sibling; the plugin guard checks again.
    "helper-tools": [
      { "action": "tool", "resource": "helpers_status" },
      { "action": "tool", "resource": "helpers_steer" },
      { "action": "tool", "resource": "helpers_cancel" }
    ]
  },

  "agents": {
    "lead": {
      "mode": "primary",
      "description": "Talks to you, plans, hands work to helpers and checks the results. Start here.",
      "prompt": ["agents/lead.md"],
      "budget": "lead",
      "color": "#0b5394",
      "permissions": [
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "delegate", "resource": "*", "effect": "deny" },
        { "action": "delegate", "resource": "scout", "effect": "allow" },
        { "action": "delegate", "resource": "builder", "effect": "allow" },
        { "action": "delegate", "resource": "reviewer", "effect": "allow" },
        { "use": "approval-needed", "effect": "ask" }
      ]
    },

    "scout": {
      "mode": "subagent",
      "description": "Read-only lookups and investigations in code, docs or the web. Returns a short answer with file:line evidence; long findings go to a notes file.",
      "prompt": ["agents/scout.md"],
      "budget": "helper",
      "steps": 30,
      // Edits are denied except the notes folder. Paths match relative to the repository root
      // (v1) or the session directory (v2); the second pattern covers sessions started in a
      // subdirectory.
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": ".ecmwf-multi-agents/notes/*", "effect": "allow" },
        { "action": "edit", "resource": "*/.ecmwf-multi-agents/notes/*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "use": "read-only-shell", "effect": "allow" },
        { "action": "delegate", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "todo", "resource": "*", "effect": "deny" },
        { "action": "execute", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "ecmwf-multi-agents-*", "effect": "deny" },
        { "use": "helper-tools", "effect": "deny" }
      ]
    },

    "builder": {
      "mode": "subagent",
      "description": "Makes one clearly specified change, runs its checks and reports. Never commits.",
      "prompt": ["agents/builder.md"],
      "budget": "helper",
      "steps": 60,
      "permissions": [
        { "use": "git-writes", "effect": "deny" },
        { "action": "shell", "resource": "gh *", "effect": "deny" },
        { "action": "delegate", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "ecmwf-multi-agents-*", "effect": "deny" },
        { "use": "helper-tools", "effect": "deny" }
      ]
    },

    "reviewer": {
      "mode": "subagent",
      "description": "Independent review of a plan or a change. Answers APPROVE or REJECT with at most three blockers.",
      "prompt": ["agents/reviewer.md"],
      "budget": "helper",
      "steps": 30,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "use": "git-writes", "effect": "deny" },
        { "action": "shell", "resource": "gh *", "effect": "deny" },
        { "use": "gh-read", "effect": "allow" },
        { "action": "delegate", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "todo", "resource": "*", "effect": "deny" },
        { "action": "execute", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "ecmwf-multi-agents-*", "effect": "deny" },
        { "use": "helper-tools", "effect": "deny" }
      ]
    }
  },

  // Names checked against opencode's built-in commands in docs/research/command-clashes.md.
  // `review` deliberately replaces opencode's built-in review command.
  //
  // `review` and `progress` have no `subtask`: on opencode 1.x their helper answers in the
  // user's own session, so the report appears there and lead takes no extra turn to relay it,
  // and the plugin keeps the earlier conversation out of the helper's requests. opencode 2 has
  // no such mode and runs them in a child session (see tools/emit-v2.ts).
  "commands": {
    "onboard": {
      "description": "Survey this repository and keep a short summary for later sessions",
      "agent": "lead",
      "template": "commands/onboard.md"
    },
    "plan": {
      "description": "Plan a piece of work with you, then wait for your approval",
      "agent": "lead",
      "template": "commands/plan.md"
    },
    "go": {
      "description": "Carry out an approved plan task by task",
      "agent": "lead",
      "template": "commands/go.md"
    },
    "review": {
      "description": "Independent review of your uncommitted changes, a branch, a commit, a pull request or a plan",
      "agent": "reviewer",
      "template": "commands/review.md"
    },
    "progress": {
      "description": "Show progress on the current plan",
      "agent": "scout",
      "template": "commands/progress.md"
    },
    "guide": {
      "description": "How this harness works, in plain words",
      "agent": "lead",
      "template": "commands/guide.md"
    }
  },

  "skills": {
    "ecmwf-multi-agents-plan": {
      "description": "Plan file format and rules for ecmwf-multi-agents. Use when writing, updating or carrying out a plan in .ecmwf-multi-agents/plans/.",
      "body": "skills/ecmwf-multi-agents-plan/SKILL.md",
      "hidden": true
    },
    "ecmwf-multi-agents-guide": {
      "description": "User guide to the ecmwf-multi-agents harness: agents, commands, plans, review policy, settings and profiles. Use when the user asks how the harness works.",
      "body": "skills/ecmwf-multi-agents-guide/SKILL.md",
      "hidden": true
    }
  }
}
